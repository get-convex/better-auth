{
  "name": "uses-component",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:frontend": "vite --clearScreen false",
    "dev:backend": "convex dev --typecheck-components",
    "dev:build": "chokidar '../../tsconfig*.json' '../../src/**/*.ts' '../../src/**/*.tsx' -i '**/*.test.ts' -c 'npm run build' --initial",
    "build": "convex codegen --component-dir ../../src/component && cd ../../ && npm run build",
    "predev": "convex dev --skip-push && mkdir -p dist",
    "logs": "convex logs",
    "lint": "tsc -p convex && eslint convex"
  },
  "dependencies": {
    "@convex-dev/better-auth": "file:../..",
    "@convex-dev/resend": "^0.2.8",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "file:../../node_modules/better-auth",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "file:../../node_modules/convex",
    "convex-helpers": "^0.1.124",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
